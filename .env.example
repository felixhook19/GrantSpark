# GrantSpark environment variables.
# Copy to .env.local for local dev (gitignored). Real values live in
# Vercel project settings ONLY — never commit a real key; this repo is public.

# Supabase project URL (public, safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase anon key — auth only, safe to expose
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Supabase service-role key — server-only, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API key — server-only, powers matching/assistant/blog
ANTHROPIC_API_KEY=sk-ant-api03-your-key

# Canonical site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://grantspark.co.uk

# Stripe secret key (sk_test_... locally; Felix sets sk_live_ in Vercel)
STRIPE_SECRET_KEY=sk_test_your-key
# Stripe webhook signing secret for /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your-secret
# Stripe recurring price for Seeker £29/month (maps to DB plan 'pro')
STRIPE_PRICE_ID_SEEKER=price_your-seeker-price
# Stripe recurring price for Strategist £99/month (maps to DB plan 'multi')
STRIPE_PRICE_ID_STRATEGIST=price_your-strategist-price
# Stripe publishable key (client-side, safe to expose)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key

# Resend API key for digest emails (optional — email degrades gracefully)
RESEND_API_KEY=re_your-key

# Shared secret protecting /api/cron/* and /api/admin/run-* endpoints
CRON_SECRET=generate-a-long-random-string

# Upstash Redis for rate limiting (optional — limiter no-ops without it)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token
# Max AI-spending requests per user per day
RATE_LIMIT_DAILY_MAX=50
# Max AI-spending requests per user per minute
RATE_LIMIT_BURST_PER_MIN=6

# Signs team-invite and calendar tokens (falls back to CRON_SECRET if unset)
INVITE_SECRET=generate-another-long-random-string
